# Application
APP_NAME=FastAPI AI Starter
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_ai
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/fastapi_ai

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256

# CORS (comma-separated or *)
CORS_ORIGINS=*

# AI provider: fake | rodiumai
AI_PROVIDER=fake
RODIUMAI_API_KEY=
RODIUMAI_BASE_URL=https://api.rodiumai.io/v1
RODIUMAI_DEFAULT_MODEL=openai/gpt-4o-mini
RODIUMAI_EMBEDDING_MODEL=openai/text-embedding-3-small
RODIUMAI_TIMEOUT=60
RODIUMAI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=30
AI_DAILY_TOKEN_QUOTA=100000

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage/uploads
STORAGE_MAX_UPLOAD_MB=10
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# i18n
DEFAULT_LOCALE=fr
